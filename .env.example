# Variáveis de ambiente usadas pelo sgis/settings.py.
# Nenhuma é obrigatória localmente: sem elas valem os padrões de desenvolvimento
# (DEBUG ligado, SQLite e senha IS "is123456").
# No Render elas são definidas pelo render.yaml e pelo painel; não commite um .env.

# "True" ou "False". Padrão: True localmente, False no Render.
DEBUG=True

# Obrigatória quando DEBUG=False. No Render é gerada automaticamente.
SECRET_KEY=troque-isto

# Padrão: sqlite:///db.sqlite3. No Render vem do banco Postgres.
DATABASE_URL=sqlite:///db.sqlite3

# Conta inicial da IS, criada pela migração usuarios/0002.
# No Render, sem IS_SENHA_INICIAL a conta não é criada.
IS_EMAIL=is@sgis.com
IS_SENHA_INICIAL=troque-isto
